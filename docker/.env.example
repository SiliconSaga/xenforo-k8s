# Copy to .env and edit. `.env` is gitignored.

# Required — compose refuses to start without it.
XF_DB_PASSWORD=change-me

XF_DB_DATABASE=xenforo
XF_DB_USER=xenforo

XF_TITLE=XenForo
XF_COOKIE_PREFIX=xf_

# Host port the forum is served on.
HTTP_PORT=8080

# Set to 1 only while developing against XenForo internals.
XF_DEBUG=

# Build-time toggles. Both add pecl builds and noticeable image build time.
PHP_VERSION=8.4
PHP_BUILD_IMAGICK=0
PHP_BUILD_REDIS=0
